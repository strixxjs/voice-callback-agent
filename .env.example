# App
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_agent
INTERNAL_API_SECRET=change-me
PUBLIC_BASE_URL=http://localhost:8000

# Call rules
CALL_TIMEZONE=Europe/Warsaw
CALL_HOURS_START=09:00
CALL_HOURS_END=20:00
RETRY_AFTER_MINUTES=15
MAX_CALL_ATTEMPTS=2

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIP_OUTBOUND_TRUNK_ID=
# Empty for automatic dispatch (LiveKit Playground / dev); set name for explicit dispatch (e.g. callback-agent)
AGENT_DISPATCH_NAME=

# Models & Voice Pipeline
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
# Optional fallback model (e.g. gemini-3.5-flash or another model supported by provider)
# If set, primary and fallback are wrapped with LiveKit's LLM FallbackAdapter
LLM_FALLBACK_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Post-call Extraction
EXTRACTION_MODEL=gemini-3.5-flash

STT_PROVIDER=deepgram
# STT model name. Empty = provider default:
# - deepgram: nova-3 (also supported: nova-2, nova-2-general)
# - openai: whisper-1
STT_MODEL=
# Language is defined in agent/script.yaml. Set STT_LANGUAGE only as an optional override:
# STT_LANGUAGE=uk
DEEPGRAM_API_KEY=

TTS_PROVIDER=elevenlabs
# TTS model name. Empty = provider default:
# - elevenlabs: eleven_turbo_v2_5 (also supported: eleven_flash_v2_5, eleven_multilingual_v2)
# - openai: tts-1 (also supported: tts-1-hd)
TTS_MODEL=
# TTS voice ID. Empty = provider default:
# - elevenlabs: hpp4J3VqNfWAUOO0d1Us
# - openai: alloy (also supported: echo, fable, onyx, nova, shimmer)
TTS_VOICE_ID=
ELEVENLABS_API_KEY=

# Turn detection & Turn-taking
# Turn detection: "vad" (local Silero, free) or "turn_detector" (inference)
TURN_DETECTION_MODE=vad
# Interruption mode: "vad" (local Silero, free) or "adaptive" (inference)
INTERRUPTION_MODE=vad
# Minimum silence (seconds) after user stops speaking before declaring turn finished (default: 0.5)
ENDPOINTING_MIN_DELAY=0.5
# Maximum wait (seconds) before forcing end of user turn (default: 3.0)
ENDPOINTING_MAX_DELAY=3.0
# Preemptive LLM generation while turn is concluding (true/false, default: true)
PREEMPTIVE_GENERATION=true

# Delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

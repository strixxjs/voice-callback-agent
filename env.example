# App
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_agent
INTERNAL_API_SECRET=change-me
PUBLIC_BASE_URL=http://localhost:8000

# Call rules
CALL_TIMEZONE=Europe/Warsaw
CALL_HOURS_START=09:00
CALL_HOURS_END=20:00
RETRY_AFTER_MINUTES=15
MAX_CALL_ATTEMPTS=2

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
AGENT_NAME=callback-agent

# Models
OPENAI_API_KEY=
LLM_MODEL=
DEEPGRAM_API_KEY=
STT_LANGUAGE=pl
ELEVENLABS_API_KEY=
TTS_VOICE_ID=

# Delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
